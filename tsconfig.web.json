{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "include": [
    "src/app/renderer/**/*",
    "src/shared/**/*",
    "src/features/*/ipc.ts",
    "src/features/*/shared/**/*",
    "src/features/*/ui/**/*"
  ]
}
