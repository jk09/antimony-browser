{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/app/main/**/*",
    "src/app/preload/**/*",
    "src/shared/**/*",
    "src/features/*/*.ts",
    "src/features/*/main/**/*",
    "src/features/*/shared/**/*",
    "e2e/**/*",
    "*.config.ts"
  ]
}
